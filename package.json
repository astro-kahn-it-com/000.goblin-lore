{
    "name": "crappy-vite-project",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run build:ts && npm exec vite build",
        "build:ts": "tsc -b",
        "clean": "tsc --build --clean && rm -rf types dist",
        "uninstall": "npm run clean && rm -rf node_modules package-lock.json",
        "lint": "npm run build:ts && eslint .",
        "format": "prettier . --write",
        "fix": "npm run build:ts && npm run format && npm run lint -- --fix",
        "preview": "vite preview",
        "postinstall": "./bin/esbuild-patch.sh && npm run build"
    },
    "dependencies": {
        "prettier": "^3.9.6",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@snailicid3/config": "^0.1.4",
        "esbuild": "^0.28.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.1"
    },
    "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
