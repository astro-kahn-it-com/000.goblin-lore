{
    "name": "crappy-vite-project",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run build:ts && vite",
        "build": "npm run build:ts && npm exec vite build",
        "build:ts": "tsc -b",
        "clean": "tsc --build --clean && rm -rf types dist",
        "uninstall": "npm run clean && rm -rf node_modules package-lock.json",
        "lint": "npm run build:ts && eslint .",
        "lint:md": "npm exec markdownlint-cli2",
        "lint:verbose": "npm run lint -- --debug",
        "format": "prettier . --write",
        "fix": "npm run build:ts && npm run format && npm run lint -- --fix",
        "fix:md": "npm exec prettier './**/*.md' '!**/*.api.md' --write &&  npm run lint:md -- --fix",
        "check": "npm run build:ts && npm run lint",
        "check:md": "npm exec prettier './**/*.md' '!**/*.api.md' &&  npm run lint:md",
        "preview": "vite preview",
        "postinstall": "./bin/esbuild-patch.sh && npm run build"
    },
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@snailicid3/config": "^0.2.0",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "esbuild": "^0.28.1",
        "markdownlint-cli2": "^0.23.1",
        "patch-package": "^8.0.1",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vite": "^8.1.1"
    },
    "engines": {
        "node": "^20.11.0",
        "npm": ">=10.0.0"
    },
    "packageManager": "npm@10.9.2"
}
