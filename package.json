{
    "name": "@snailicid3/consumer-npm",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "\n========== COMMIT >> ==========": "",
        "commit": "npm run build:ts && npm exec -- scope-commit --checked-commit",
        "commit:feat": "npm run commit feat",
        "commit:fix": "npm run commit fix",
        "commit:chore": "npm run commit chore",
        "commit:refactor": "npm run commit refactor",
        "commit:test": "npm run commit test",
        "commit:build": "npm run commit build",
        "commit:docs": "npm run commit docs",
        "commit:direct": "npm run build:ts&& npm exec scope-commit --checked-commit --skip-lint-staged",
        "changeset": "npm exec gbt-changeset",
        "changeset:status": "npm exec changeset status",
        "changeset:version": "npm exec changeset version",
        "release": "npm exec changeset publish",
        "commitlint": "npm exec commitlint",
        "dev": "npm run build:ts && vite",
        "build": "npm run build:ts && npm exec vite build",
        "build:ts": "tsc -b",
        "clean": "tsc --build --clean && rm -rf types dist",
        "uninstall": "npm run clean && rm -rf node_modules package-lock.json",
        "lint": "npm run build:ts && eslint .",
        "lint:md": "npm exec markdownlint-cli2",
        "lint:verbose": "npm run lint -- --debug",
        "format": "prettier . --write",
        "fix": "npm run build:ts && npm run format && npm run lint -- --fix",
        "fix:md": "npm exec prettier './**/*.md' '!**/*.api.md' --write &&  npm run lint:md -- --fix",
        "check": "npm run build:ts && npm run lint",
        "check:md": "npm exec prettier './**/*.md' '!**/*.api.md' &&  npm run lint:md",
        "lint:staged": "npm exec lint-staged --relative",
        "preview": "vite preview",
        "prepare": "husky",
        "inspect:dependencies": "npm run build:ts  && npm exec inspect-deps",
        "inspect:lint": "npm exec eslint-config-inspector -- --no-open",
        "inspect:deps": "npm run inspect:dependencies",
        "postinstall": "npm exec patch-package && ./bin/esbuild-patch.sh && npm run build"
    },
    "dependencies": {
        "knip": "^6.29.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@commitlint/cli": "^21.2.1",
        "@snailicid3/config": "^0.2.0",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "16.4.0",
        "markdownlint-cli2": "^0.23.1",
        "patch-package": "^8.0.1",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vite": "^8.1.1"
    },
    "engines": {
        "node": "^20.11.0",
        "npm": ">=10.0.0"
    },
    "packageManager": "npm@10.9.2"
}
