/** emitted typescript files that are in final distribution */
/*
 * Emitted:
 * - JS : true
 * - Types : true
 */
{
    "extends": "@snailicid3/config/tsconfig.library",
    "include": ["./src/**/*.ts", "./src/**/*.cts", "./src/**/*.mts"],
    "exclude": ["**/*.test.ts", "**/*.test.mts", "**/*.test.cts"],
    "compilerOptions": {
        "types": ["node"],
        "outDir": "./types"
    }
}
