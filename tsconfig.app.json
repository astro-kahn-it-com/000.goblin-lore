{
    "extends": "@snailicid3/config/tsconfig.react",
    "compilerOptions": {
        "noEmit": true
        //or "emitDeclarationOnly": false
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.cts",
        "./src/**/*.mts",
        "./src/**/*.tsx"
    ],
    "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mts",
        "**/*.test.cts",
        "./src/**/*.stories.tsx"
    ]
}
